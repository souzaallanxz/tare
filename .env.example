# Copy to .env.local (gitignored) and fill in real values.
# NEVER put real secrets in this file — it is committed.

# Neon Postgres, EU region. Pooled URL for the app, direct URL for migrations.
DATABASE_URL=""
DATABASE_URL_DIRECT=""

# 32 bytes, base64. Envelope-encryption KEK. Never commit. Losing this is irrecoverable by design.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TARE_MASTER_KEY=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (openid, email, profile only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (weekly report). Provider TBD in phase 1d.
EMAIL_FROM="Tare <reports@tare.example>"
RESEND_API_KEY=""

# Ingest cron guard. Any long random string.
CRON_SECRET=""
